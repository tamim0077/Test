# Local development: no production database writes for local guest exams.
NODE_ENV=development
DATA_STORE=local
HOST=127.0.0.1
PORT=3000
LOCAL_DATA_FILE=.local-data/examdna.json

# Production (configure privately on the host; do not commit credentials):
# NODE_ENV=production
# DATA_STORE=firestore
# HOST=0.0.0.0
# FIREBASE_PROJECT_ID=<same project as firebase-applet-config.json>
# FIRESTORE_DATABASE_ID=<same database as firebase-applet-config.json>
# Use Application Default Credentials / the host's authorized service identity.
# GOOGLE_APPLICATION_CREDENTIALS=<local private credential path only if needed>
# Never add private keys to this repository, the browser bundle, or a chat.

